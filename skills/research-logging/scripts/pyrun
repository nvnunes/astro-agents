#!/usr/bin/env python3
"""Run an entry-local Python command with research-log token resolution."""

from __future__ import annotations

import csv
import re
import subprocess
import sys
from pathlib import Path


TOKEN_RE = re.compile(r"<([^<>]+)>")


def usage() -> int:
    print("usage: pyrun <script> [args...]", file=sys.stderr)
    return 2


def project_root(cwd: Path) -> Path:
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit("pyrun: could not resolve project root with git") from exc
    return Path(output.strip())


def python_executable(root: Path) -> str:
    project_conda = root / ".conda" / "bin" / "python"
    if project_conda.exists():
        return str(project_conda)
    return sys.executable


def is_log_root(candidate: Path) -> bool:
    return (candidate / "entries").is_dir() and (candidate.parent / f"{candidate.name}.md").is_file()


def log_root(cwd: Path) -> Path:
    for candidate in [cwd, *cwd.parents]:
        if is_log_root(candidate):
            return candidate

    parts = cwd.parts
    for index, part in enumerate(parts):
        if part != "entries" or index == 0:
            continue
        candidate = Path(*parts[:index])
        if is_log_root(candidate):
            return candidate

    raise SystemExit(
        "pyrun: could not resolve log root; expected a <log>.md sibling and <log>/entries/"
    )


def data_index_candidates(cwd: Path) -> list[Path]:
    return [
        cwd / "data" / "index.csv",
        cwd.parent / "data" / "index.csv",
    ]


def find_data_index(cwd: Path) -> Path | None:
    for candidate in data_index_candidates(cwd):
        if candidate.is_file():
            return candidate
    return None


def data_locations(index: Path | None) -> dict[str, str]:
    if index is None:
        return {}

    try:
        with index.open(newline="", encoding="utf-8") as handle:
            reader = csv.DictReader(handle)
            if reader.fieldnames is None:
                raise SystemExit(f"pyrun: empty data index: {index}")

            fieldnames = {name.strip().lower(): name for name in reader.fieldnames if name}
            missing = {"name", "type", "location"} - set(fieldnames)
            if missing:
                missing_text = ", ".join(sorted(missing))
                raise SystemExit(f"pyrun: data index missing required column(s) {missing_text}: {index}")

            locations: dict[str, str] = {}
            for line_number, row in enumerate(reader, start=2):
                name = (row.get(fieldnames["name"]) or "").strip()
                location = (row.get(fieldnames["location"]) or "").strip()
                if not name and not location:
                    continue
                if not name or not location:
                    raise SystemExit(f"pyrun: malformed data index row {line_number}: {index}")
                locations[name] = location
    except csv.Error as exc:
        raise SystemExit(f"pyrun: malformed CSV data index: {index}: {exc}") from exc

    return locations


def resolve_location(location: str, index: Path) -> str:
    path = Path(location).expanduser()
    if path.is_absolute():
        return str(path)
    return str((index.parent / path).resolve())


def resolve_arg(arg: str, root: Path, log: Path, locations: dict[str, str], index: Path | None) -> str:
    def replace(match: re.Match[str]) -> str:
        name = match.group(1)
        if name == "project":
            return str(root)
        if name == "log":
            return str(log)
        if name == "theme":
            raise SystemExit("pyrun: <theme> is no longer supported; use <log>")
        if name in locations:
            if index is None:
                raise SystemExit(f"pyrun: internal error resolving data name without data index: {name}")
            return resolve_location(locations[name], index)
        raise SystemExit(f"pyrun: unresolved token <{name}> in argument: {arg}")

    return TOKEN_RE.sub(replace, arg)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return usage()

    cwd = Path.cwd()
    root = project_root(cwd)
    log = log_root(cwd)
    index = find_data_index(cwd)
    locations = data_locations(index)
    resolved = [resolve_arg(arg, root, log, locations, index) for arg in argv[1:]]

    return subprocess.run([python_executable(root), *resolved], cwd=cwd).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
