RESERVED_TOKEN_RE = re.compile(r"<(project|log|theme)>")
CAPTURE_POLL_SECONDS = 0.05
CAPTURE_TERMINATION_SECONDS = 1.0
CAPTURE_DRAIN_SECONDS = 10.0


def usage() -> int:
    print(
        "usage: pyrun <script.py> [args...]\n"
        "       pyrun --cid COMMAND_ID_OR_NUMBER -- <script> [args...]\n"
        "       pyrun [--cid COMMAND_ID_OR_NUMBER] [--auto-reproduce=false] "
        "[--exclusive] "
        "[--env NAME=value] "
        "[--other-inputs <selectors>] "
        "[--other-outputs <selectors>]\n"
        "             [--capture-stdout <path>] "
        "[--capture-stderr <path>] -- <script> [args...]\n"
        "       pyrun --capture-stdout-stderr <path> -- <script> [args...]\n"
        "A numeric --cid N resolves to the full ID <script-stem>-N.",
        file=sys.stderr,
    )
    return 2


def project_root(cwd: Path) -> Path:
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise SystemExit("pyrun: could not resolve project root with git") from error
    return Path(output.strip()).resolve()


def python_executable(root: Path) -> str:
    project_conda = root / ".conda" / "bin" / "python"
    if project_conda.exists():
        return str(project_conda)
    return sys.executable


def is_log_root(candidate: Path) -> bool:
    return (candidate / "entries").is_dir() and (
        candidate.parent / f"{candidate.name}.md"
    ).is_file()


def log_root(cwd: Path) -> Path:
    for candidate in [cwd, *cwd.parents]:
        if is_log_root(candidate):
            return candidate.resolve()
    raise SystemExit(
        "pyrun: could not resolve log root; expected a <log>.md sibling and "
        "<log>/entries/"
    )


def find_entry_root(cwd: Path, log: Path) -> Path | None:
    entries = (log / "entries").resolve()
    for candidate in [cwd, *cwd.parents]:
        resolved = candidate.resolve()
        if resolved.parent == entries:
            return resolved
        if resolved == entries:
            break
    return None


def require_entry_root(cwd: Path, log: Path) -> Path:
    entry = find_entry_root(cwd, log)
    if entry is None:
        raise SystemExit("pyrun: execution must run within an entry")
    return entry


def _load_data(entry: Path) -> DataFile | None:
    """Load the execution-time registry without owning its authoring lifecycle."""

    path = entry / "data.json"
    legacy = entry / "data.csv"
    unsupported = [
        candidate
        for root in (entry.parent, entry.parent.parent)
        for candidate in (root / "data.json", root / "data.csv")
        if candidate.exists() or candidate.is_symlink()
    ]
    if unsupported:
        raise SystemExit(
            "pyrun: parent or log-level data files are unsupported: "
            + ", ".join(str(candidate) for candidate in unsupported)
        )
    if path.exists() and legacy.exists():
        raise SystemExit(f"pyrun: conflicting data.json and data.csv: {entry}")
    if legacy.exists() or legacy.is_symlink():
        raise SystemExit(f"pyrun: legacy data.csv is unsupported: {legacy}")
    if not path.exists() and not path.is_symlink():
        return None
    try:
        return load_data_file(path, entry_root=entry)
    except DataContractError as error:
        raise SystemExit(f"pyrun: {error}") from error


def _reserved_tokens(arg: str, root: Path, log: Path) -> str:
    def replace_reserved(match: re.Match[str]) -> str:
        name = match.group(1)
        if name == "project":
            return str(root)
        if name == "log":
            return str(log)
        raise SystemExit("pyrun: <theme> is no longer supported; use <log>")

    return RESERVED_TOKEN_RE.sub(replace_reserved, arg)


def resolve_arg(
    arg: str,
    root: Path,
    log: Path,
    data: DataFile | None,
    verified: set[str],
    observed_inputs: dict[str, Fingerprint],
    fingerprint_cache: FingerprintCache,
) -> str:
    expanded = _reserved_tokens(arg, root, log)
    if not input_token_candidate(expanded):
        return expanded
    try:
        resolved = resolve_input_token(expanded, data)
    except DataContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    resource = resolved.resource
    if resource.name not in verified:
        try:
            observation = fingerprint_cache.observe_resource(resource)
        except (DataContractError, FingerprintCacheError) as error:
            raise SystemExit(f"pyrun: {error}") from error
        if observation is None:
            raise SystemExit(f"pyrun: could not observe input {resource.name!r}")
        observed_inputs[resource.name] = observation.fingerprint
        verified.add(resource.name)
    return resolved.value


def resolve_output_arg(arg: str, root: Path, log: Path, data: DataFile | None) -> str:
    """Resolve one explicitly output-directed artifact token without reading it."""

    expanded = _reserved_tokens(arg, root, log)
    if input_token_parts(expanded) is None:
        return expanded
    try:
        resolved = resolve_input_token(expanded, data)
    except DataContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    if (
        resolved.resource.origin
        or resolved.resource.reference_entry is not None
        or resolved.member is not None
    ):
        raise SystemExit("pyrun: outputs require a whole generated artifact token")
    return resolved.value


def _execution_layout(
    argv: list[str],
) -> tuple[
    str,
    str,
    tuple[str, ...],
    tuple[str, ...],
    dict[str, str],
    dict[str, str],
    dict[str, str],
    bool,
    bool,
]:
    """Return the shared runner layout used to execute and publish support."""

    try:
        layout = parse_pyrun_arguments(argv[1:])
    except PyrunContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    return (
        layout.cid,
        layout.script,
        layout.script_arguments,
        layout.recipe_parameters,
        dict(layout.captures),
        dict(layout.roles),
        dict(layout.environment),
        layout.auto_reproduce,
        layout.exclusive,
    )


def _execution_environment(
    explicit: dict[str, str],
    root: Path,
    python_context: PythonExecutionContext,
) -> dict[str, str]:
    """Return the child environment with isolated runner-owned cache roots."""

    environment = os.environ.copy()
    environment.update(explicit)
    environment["MPLCONFIGDIR"] = str(root / "matplotlib")
    environment["XDG_CACHE_HOME"] = str(root / "cache")
    environment["PYTHONPYCACHEPREFIX"] = str(root / "pycache")
    return python_context.environment(environment)


def _selected_values(
    arguments: tuple[str, ...], roles: dict[str, str], direction: str
) -> tuple[str, ...]:
    """Return every value selected for one explicit material direction."""

    options, positionals = split_argument_values(arguments)
    result: list[str] = []
    for occurrence in options:
        if roles.get(occurrence.name) == direction:
            result.append(occurrence.value)
    for index, value in enumerate(positionals, 1):
        if roles.get(f"@{index}") == direction:
            result.append(value)
    return tuple(result)


def _material_value_roles(
    arguments: tuple[str, ...], roles: dict[str, str]
) -> dict[str, str]:
    """Return each material value's explicit or conventional direction."""

    selected: dict[str, set[str]] = {}
    options, positionals = split_argument_values(arguments)
    for option in options:
        role = roles.get(option.name, automatic_option_role(option.name))
        if role is not None:
            selected.setdefault(option.value, set()).add(role)
    for index, value in enumerate(positionals, 1):
        role = roles.get(f"@{index}")
        if role is not None:
            selected.setdefault(value, set()).add(role)
    conflicts = sorted(value for value, found in selected.items() if len(found) != 1)
    if conflicts:
        raise SystemExit("pyrun: material values have conflicting roles")
    return {value: next(iter(found)) for value, found in selected.items()}


def _require_declared_input_tokens(
    arguments: tuple[str, ...], roles: dict[str, str], data: DataFile | None
) -> None:
    """Require explicit input roles to resolve through the owning registry."""

    for value in _selected_values(arguments, roles, "input"):
        expanded = value
        if not input_token_candidate(expanded):
            raise SystemExit(
                "pyrun: --other-inputs values must use registered input tokens"
            )
        try:
            resolve_input_token(expanded, data)
        except DataContractError as error:
            raise SystemExit(f"pyrun: {error}") from error


def _declared_outputs(
    arguments: tuple[str, ...],
    captures: dict[str, str],
    roles: dict[str, str],
    entry: Path,
    root: Path,
    log: Path,
    data: DataFile | None,
) -> dict[str, tuple[Path, str | None]]:
    """Resolve outputs and any runner-enforced kind at the process boundary."""

    outputs: list[tuple[str, str | None]] = [
        (target, "file") for target in captures.values()
    ]
    options, positionals = split_argument_values(arguments)
    for option in options:
        role = roles.get(option.name, automatic_option_role(option.name))
        if role == "output":
            outputs.append((option.value, None))
    for index, value in enumerate(positionals, 1):
        if roles.get(f"@{index}") == "output":
            outputs.append((value, None))
    result: dict[str, tuple[Path, str | None]] = {}
    for raw, kind in outputs:
        named = input_token_parts(raw) is not None
        if named:
            try:
                resolved = resolve_input_token(raw, data)
            except DataContractError as error:
                raise SystemExit(f"pyrun: {error}") from error
            if resolved.resource.origin or resolved.member is not None:
                raise SystemExit(
                    "pyrun: outputs require a whole generated artifact token"
                )
            raw = resolved.value
            kind = resolved.resource.kind
        key = portable_output_path(
            raw,
            entry_root=entry,
            project_root=root,
            authored=not named,
        )
        path = output_target_path(
            key, entry_root=entry, project_root=root, authored=True
        )
        if key in result:
            raise SystemExit(f"pyrun: duplicate output target: {key}")
        result[key] = (path, kind)
    return result


def _capture_paths(
    captures: dict[str, str],
    entry: Path,
    root: Path,
    log: Path,
    data: DataFile | None,
) -> dict[str, Path]:
    result: dict[str, Path] = {}
    for option, raw in captures.items():
        named = input_token_parts(raw) is not None
        raw = resolve_output_arg(raw, root, log, data)
        key = portable_output_path(
            raw,
            entry_root=entry,
            project_root=root,
            authored=not named,
        )
        path = output_target_path(
            key,
            entry_root=entry,
            project_root=root,
            authored=True,
        )
        result[option] = path
    return result


def _canonical_output_parameters(
    parameters: tuple[str, ...],
    data: DataFile | None,
    *,
    entry: Path,
    root: Path,
    outputs: Mapping[str, tuple[Path, str | None]],
) -> tuple[str, ...]:
    """Normalize named outputs to their path-based recipe identity."""

    if data is None:
        return parameters
    output_targets = {path.resolve().as_posix() for path, _kind in outputs.values()}
    aliases = {
        f"<{resource.name}>": portable_output_path(
            resource.canonical_target,
            entry_root=entry,
            project_root=root,
            authored=False,
        )
        for resource in data.inputs
        if not resource.origin and resource.canonical_target in output_targets
    }
    result = []
    for parameter in parameters:
        if parameter in aliases:
            result.append(aliases[parameter])
            continue
        if parameter.startswith("-") and "=" in parameter:
            prefix, value = parameter.split("=", 1)
            if value in aliases:
                result.append(f"{prefix}={aliases[value]}")
                continue
        result.append(parameter)
    return tuple(result)


def _run_with_captures(
    command: list[str],
    captures: dict[str, Path],
    cwd: Path,
    environment: dict[str, str],
) -> int:
    """Run one process while mirroring each requested captured byte stream."""

    if not captures:
        process = subprocess.Popen(
            command, cwd=cwd, env=environment, start_new_session=True
        )
        try:
            return process.wait()
        finally:
            _finish_process(process, None)
    capture = StreamCapture()
    combined = captures.get("--capture-stdout-stderr")
    with ExitStack() as stack:
        handles = {
            option: stack.enter_context(path.open("wb"))
            for option, path in captures.items()
        }
        process = subprocess.Popen(
            command,
            cwd=cwd,
            env=environment,
            start_new_session=True,
            stdout=subprocess.PIPE
            if combined is not None or "--capture-stdout" in captures
            else None,
            stderr=(
                subprocess.STDOUT
                if combined is not None
                else subprocess.PIPE
                if "--capture-stderr" in captures
                else None
            ),
        )
        stack.callback(_finish_process, process, capture)

        if process.stdout is not None:
            option = (
                "--capture-stdout-stderr"
                if combined is not None
                else "--capture-stdout"
            )
            capture.start(
                process.stdout,
                (
                    StreamDestination(option, handles[option], True, durable=True),
                    StreamDestination(
                        "stdout mirror",
                        sys.stdout.buffer,
                        False,
                        flush_each_chunk=True,
                    ),
                ),
            )
        if process.stderr is not None:
            capture.start(
                process.stderr,
                (
                    StreamDestination(
                        "--capture-stderr",
                        handles["--capture-stderr"],
                        True,
                        durable=True,
                    ),
                    StreamDestination(
                        "stderr mirror",
                        sys.stderr.buffer,
                        False,
                        flush_each_chunk=True,
                    ),
                ),
            )
        returncode = _wait_for_captured_process(process, capture.required_failed)
        failures = capture.finish(CAPTURE_DRAIN_SECONDS)
        required = [failure for failure in failures if failure.required]
        if required:
            raise SystemExit(f"pyrun: capture failed: {required[0].error}")
        for failure in failures:
            if failure.name == "stdout mirror":
                _discard_failed_mirror(sys.stdout.fileno())
            elif failure.name == "stderr mirror":
                _discard_failed_mirror(sys.stderr.fileno())
            report = sys.stdout if failure.name == "stderr mirror" else sys.stderr
            print(
                f"pyrun: stream mirror unavailable: {failure.error}",
                file=report,
            )
        return returncode


def _discard_failed_mirror(descriptor: int) -> None:
    """Make interpreter shutdown harmless after a terminal pipe closes."""

    replacement = os.open(os.devnull, os.O_WRONLY)
    try:
        os.dup2(replacement, descriptor)
    finally:
        os.close(replacement)


def _finish_process(
    process: subprocess.Popen[bytes], capture: StreamCapture | None
) -> None:
    """Stop and reap a live child before closing captures or removing scratch."""

    if process.poll() is None:
        _terminate_process(process)
    if capture is not None:
        capture.finish(CAPTURE_DRAIN_SECONDS)


def _terminate_process(process: subprocess.Popen[bytes]) -> int:
    """Give the child a bounded shutdown interval, then kill and reap it."""

    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        return process.wait(timeout=CAPTURE_TERMINATION_SECONDS)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        return process.wait()


def _wait_for_captured_process(
    process: subprocess.Popen[bytes], capture_failed: Event
) -> int:
    """Wait normally, but terminate a child whose capture destination failed."""

    while process.poll() is None:
        if not capture_failed.wait(CAPTURE_POLL_SECONDS):
            continue
        return _terminate_process(process)
    return process.wait()


def _observe_output(
    path: Path, expected_kind: str | None, fingerprint_cache: FingerprintCache
) -> tuple[str, Fingerprint]:
    """Observe a captured file or the completed kind of an ordinary output."""

    kind = expected_kind or ("directory" if path.is_dir() else "file")
    try:
        observation = (
            fingerprint_cache.observe_directory(path)
            if kind == "directory"
            else fingerprint_cache.observe_regular_file(path)
        )
    except (DataContractError, FingerprintCacheError) as error:
        raise SystemExit(f"pyrun: could not observe output {path}: {error}") from error
    return kind, observation.fingerprint


def _observe_effective_code(
    script: Path,
    *,
    project: Path,
    explicit_env: Mapping[str, str],
    python_context: PythonExecutionContext,
) -> Fingerprint | None:
    """Return one complete effective-code observation, or none if unsupported."""

    if "PYTHONPATH" in explicit_env:
        return None
    try:
        result = analyze_effective_code(
            script,
            project_root=project,
            import_roots=python_context.import_roots,
        )
    except EffectiveCodeError as error:
        raise SystemExit(f"pyrun: effective-code analysis failed: {error}") from error
    return _effective_fingerprint(result.fingerprint)


def _effective_fingerprint(
    value: EffectiveCodeFingerprint | None,
) -> Fingerprint | None:
    return (
        Fingerprint(value.algorithm, digest=value.digest) if value is not None else None
    )


def _confirm_effective_code(
    expected: Fingerprint | None,
    script: Path,
    *,
    project: Path,
    explicit_env: Mapping[str, str],
    python_context: PythonExecutionContext,
) -> Fingerprint | None:
    """Require supported effective code to remain stable through execution."""

    if expected is None:
        return None
    current = _observe_effective_code(
        script,
        project=project,
        explicit_env=explicit_env,
        python_context=python_context,
    )
    if current != expected:
        raise SystemExit("pyrun: effective code changed during execution; rerun")
    return current


def _command_markdown(
    entry: EntryContext, project: Path, cid: str
) -> tuple[object, ...]:
    """Snapshot the selected command, not prose or neighboring fences."""

    declarations: list[object] = []
    for path in sorted(entry.root.glob(f"{entry.id}*.md")):
        context = CommandDeclarationContext(
            entry.log.root.as_posix(),
            entry.id,
            path.relative_to(entry.log.root).as_posix(),
            entry.root,
            entry.log.root,
            project,
            None,
        )
        declarations.extend(
            (path.name, item.parsed)
            for item in index_commands(path.read_text(), context).declarations
            if item.parsed.cid == cid
        )
    return tuple(declarations)


def _recipe_authority(state: PyrunFile, cid: str) -> tuple[object, ...]:
    command = state.commands.get(cid)
    return (
        tuple(
            (key, item.recipe, item.auto_reproduce, item.exclusive)
            for key, item in sorted(command.executions.items())
        )
        if command
        else ()
    )


@dataclass(frozen=True)
class _ExecutionAuthority:
    """Relevant authored authority retained across unlocked ordinary execution."""

    entry: EntryContext
    project: Path
    data: DataFile | None
    state: PyrunFile
    markdown: tuple[object, ...]

    def require_current(self, cid: str, values: tuple[str, ...]) -> PyrunFile:
        current_data = _load_data(self.entry.root)
        for value in values:
            parts = input_token_parts(value)
            if parts is None:
                continue
            name = parts[0]
            before = self.data.by_name.get(name) if self.data else None
            after = current_data.by_name.get(name) if current_data else None
            if resource_authority(before) != resource_authority(after):
                raise SystemExit(f"pyrun: declaration changed: {name}; sync and rerun")
        if _command_markdown(self.entry, self.project, cid) != self.markdown:
            raise SystemExit(f"pyrun: Markdown command changed: {cid}; sync and rerun")
        path = self.entry.root / "pyrun.json"
        current = (
            load_pyrun_state(
                path, entry_root=self.entry.root, project_root=self.project
            )
            if path.exists()
            else empty_pyrun_state(self.entry.root)
        )
        if _recipe_authority(self.state, cid) != _recipe_authority(current, cid):
            raise SystemExit(f"pyrun: command recipe changed: {cid}; sync and rerun")
        return current


def _confirm_execution_materials(
    script: Path,
    expected_script: Fingerprint,
    data: DataFile | None,
    inputs: dict[str, Fingerprint],
    cache: FingerprintCache,
    *,
    stage: str = "execution",
) -> None:
    """Recheck expensive observations unlocked, after reserving or executing."""

    try:
        if cache.observe_regular_file(script).fingerprint != expected_script:
            raise SystemExit(
                f"pyrun: script bytes changed during {stage}; sync and rerun"
            )
        if data is not None:
            for name, expected in sorted(inputs.items()):
                current = cache.observe_resource(data.by_name[name])
                if current is None or current.fingerprint != expected:
                    raise SystemExit(
                        f"pyrun: input {name!r} changed during {stage}; sync and rerun"
                    )
    except (DataContractError, FingerprintCacheError) as error:
        raise SystemExit(
            f"pyrun: could not re-observe execution materials: {error}"
        ) from error


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return usage()

    cwd = Path.cwd()
    root = project_root(cwd)
    log = log_root(cwd)

    entry = require_entry_root(cwd, log)
    entry_identity = parse_entry_directory_name(entry.name)
    if entry_identity is None:
        raise SystemExit("pyrun: could not resolve stable entry ID")
    operation_entry = EntryContext(
        LogContext(log.parent / f"{log.name}.md", log), entry_identity.id, entry
    )
    try:
        with (
            FingerprintCache(root, writable=True) as fingerprint_cache,
            ExitStack() as reservations,
        ):
            with entry_lock(operation_entry):
                initial_state = quarantine_invalid_pyrun_state(entry, project_root=root)
                data = _load_data(entry)
                authority = _ExecutionAuthority(
                    operation_entry,
                    root,
                    data,
                    initial_state,
                    _command_markdown(
                        operation_entry, root, _execution_layout(argv)[0]
                    ),
                )
            legacy_state = entry / "pyrun-outputs.json"
            if legacy_state.exists() or legacy_state.is_symlink():
                raise SystemExit(
                    "pyrun: legacy pyrun-outputs.json requires execution-state "
                    "migration before another run"
                )
            (
                cid,
                script_argument,
                script_args,
                parameters,
                captures,
                roles,
                explicit_env,
                auto_reproduce,
                exclusive,
            ) = _execution_layout(argv)
            parameter_roles = effective_parameter_roles(script_args, roles)
            _require_declared_input_tokens(script_args, roles, data)
            material_roles = _material_value_roles(script_args, roles)
            verified: set[str] = set()
            observed_inputs: dict[str, Fingerprint] = {}
            script_identity = portable_script_path(
                script_argument,
                entry_root=entry,
                project_root=root,
                authored=True,
            )
            script_path = script_target_path(
                script_identity, entry_root=entry, project_root=root
            )
            python_context = PythonExecutionContext.for_research_script(
                script_path,
                entry_root=entry,
                log_root=log,
                project_root=root,
            )
            try:
                script_observation = fingerprint_cache.observe_regular_file(script_path)
            except FingerprintCacheError as error:
                raise SystemExit(f"pyrun: could not observe script: {error}") from error
            resolved_arguments = []
            for arg in script_args:
                if material_roles.get(arg) == "output":
                    resolved_arguments.append(resolve_output_arg(arg, root, log, data))
                else:
                    resolved_arguments.append(
                        resolve_arg(
                            arg,
                            root,
                            log,
                            data,
                            verified,
                            observed_inputs,
                            fingerprint_cache,
                        )
                    )
            try:
                require_git_repository_token_pairs(script_args, data)
            except DataContractError as error:
                raise SystemExit(f"pyrun: {error}") from error
            output_paths = _declared_outputs(
                script_args, captures, roles, entry, root, log, data
            )
            parameters = _canonical_output_parameters(
                parameters,
                data,
                entry=entry,
                root=root,
                outputs=output_paths,
            )
            if output_paths:
                validate_output_paths(
                    tuple(output_paths), entry_root=entry, project_root=root
                )
                try:
                    projection = project_output_bindings(
                        parameters,
                        {key: kind for key, (_path, kind) in output_paths.items()},
                        entry_root=entry,
                        project_root=root,
                        subject=str(entry / "pyrun.json"),
                    )
                except OutputBindingError as error:
                    raise SystemExit(f"pyrun: {error}") from error
                for binding in projection.parameters:
                    if binding.parameter_index is not None:
                        resolved_arguments[binding.parameter_index] = (
                            binding.substituted(output_paths[binding.output][0])
                        )
            capture_paths = _capture_paths(captures, entry, root, log, data)
            input_paths = tuple(
                Path(resolve_input_token(value, data).path)
                for value in material_roles
                if input_token_parts(value) is not None
                and material_roles[value] != "output"
            )
            with entry_lock(operation_entry):
                authority.require_current(cid, (*script_args, *captures.values()))
                reservation = reservations.enter_context(
                    reserve_execution(
                        root,
                        entry,
                        cid,
                        (
                            *input_paths,
                            script_path,
                        ),
                        tuple(path for path, _ in output_paths.values()),
                    )
                )
            with (
                tempfile.TemporaryDirectory(prefix="pyrun-") as temporary,
                tempfile.TemporaryDirectory(
                    prefix="pyrun-scratch-", dir="/private/tmp"
                ) as scratch,
            ):
                _confirm_execution_materials(
                    script_path,
                    script_observation.fingerprint,
                    data,
                    observed_inputs,
                    fingerprint_cache,
                    stage="preparation",
                )
                effective_code = _observe_effective_code(
                    script_path,
                    project=root,
                    explicit_env=explicit_env,
                    python_context=python_context,
                )
                environment = _execution_environment(
                    explicit_env,
                    Path(temporary),
                    python_context,
                )
                environment["TMPDIR"] = scratch
                returncode = _run_with_captures(
                    [
                        python_executable(root),
                        str(Path(__file__).resolve().with_name("pyrun_worker.py")),
                        str(root),
                        reservation.identity,
                        python_executable(root),
                        str(script_path),
                        *resolved_arguments,
                    ],
                    capture_paths,
                    cwd,
                    environment,
                )
                if returncode != 0:
                    return returncode
            require_worker_finished(root, reservation.identity)
            _confirm_execution_materials(
                script_path,
                script_observation.fingerprint,
                data,
                observed_inputs,
                fingerprint_cache,
            )
            effective_code = _confirm_effective_code(
                effective_code,
                script_path,
                project=root,
                explicit_env=explicit_env,
                python_context=python_context,
            )
            observed_outputs: dict[str, Fingerprint] = {}
            output_kinds: dict[str, str] = {}
            produced_resources: dict[str, Fingerprint] = {}
            for key, (path, kind) in output_paths.items():
                if not path.exists():
                    raise SystemExit(f"pyrun: declared output is missing: {key}")
                resource = (
                    next(
                        (
                            item
                            for item in data.inputs
                            if not item.origin
                            and item.canonical_target == path.resolve().as_posix()
                        ),
                        None,
                    )
                    if data is not None
                    else None
                )
                if resource is not None:
                    try:
                        fingerprint = observe_fingerprint(resource).fingerprint
                    except DataContractError as error:
                        raise SystemExit(
                            f"pyrun: could not observe output {path}: {error}"
                        ) from error
                    output_kind = resource.kind
                    produced_resources[resource.name] = fingerprint
                else:
                    output_kind, fingerprint = _observe_output(
                        path, kind, fingerprint_cache
                    )
                output_kinds[key] = output_kind
                observed_outputs[key] = fingerprint
            recipe = build_execution_recipe(
                ExecutionRecipe(
                    script_identity,
                    parameters,
                    tuple(sorted(explicit_env.items())),
                    tuple(sorted(observed_inputs)),
                    tuple(sorted(output_kinds.items())),
                    parameter_roles,
                ),
                subject=entry / "pyrun.json",
                entry_root=entry,
                project_root=root,
            )
            observed = ObservedExecution(
                script_observation.fingerprint,
                tuple(sorted(observed_inputs.items())),
                effective_code,
                tuple(sorted(observed_outputs.items())),
            )
            completed_at = (
                datetime.now(timezone.utc)
                .replace(microsecond=0)
                .isoformat()
                .replace("+00:00", "Z")
            )
            with (
                entry_lock(operation_entry),
                artifact_transaction(root, exclude=reservation.identity),
            ):
                current_state = authority.require_current(
                    cid, (*script_args, *captures.values())
                )
                identity = execution_id(recipe)
                before_command = initial_state.commands.get(cid)
                after_command = current_state.commands.get(cid)
                before_execution = (
                    before_command.executions.get(identity) if before_command else None
                )
                after_execution = (
                    after_command.executions.get(identity) if after_command else None
                )
                if before_execution != after_execution:
                    raise SystemExit("pyrun: execution state changed; sync and rerun")
                publish_execution_locked(
                    current_state,
                    cid,
                    ordinary_execution(
                        recipe,
                        observed,
                        auto_reproduce=auto_reproduce,
                        exclusive=exclusive,
                        last_run_at=completed_at,
                    ),
                    project_root=root,
                )
            return returncode
    except PyrunContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    except PyrunOutputsError as error:
        raise SystemExit(f"pyrun: {error}") from error
    except PyrunStateError as error:
        raise SystemExit(f"pyrun: {error}") from error
    except OperationLockError as error:
        raise SystemExit(f"pyrun: operation conflict: {error}") from error
    except ArtifactReservationError as error:
        raise SystemExit(f"pyrun: {error.code}: {error}") from error
    except OSError as error:
        raise SystemExit(f"pyrun: operation state unavailable: {error}") from error


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
