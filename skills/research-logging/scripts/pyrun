#!/usr/bin/env python3
"""Run entry-local Python commands and maintain ``data.json`` inputs."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import threading
from contextlib import ExitStack, contextmanager
from dataclasses import replace
from pathlib import Path
from typing import BinaryIO, Callable, Iterable, Iterator

from research_log_data import (
    DATA_SCHEMA,
    DataContractError,
    DataFile,
    Fingerprint,
    InputResource,
    build_identity_directory,
    build_identity_pattern_directory,
    build_local_input,
    data_file_from_inputs,
    input_token_candidate,
    load_data_file,
    observe_fingerprint,
    resolve_input_token,
)
from validation.fingerprint_cache import FingerprintCache, FingerprintCacheError
from validation.pyrun_contract import (
    PyrunContractError,
    automatic_option_role,
    parse_pyrun_arguments,
    split_argument_values,
)
from validation.pyrun_outputs import (
    OutputSupport,
    PyrunOutputsError,
    ScriptSupport,
    portable_output_path,
    quarantine_invalid_pyrun_outputs,
    update_pyrun_outputs_locked,
)

from log_commands.context import EntryContext, LogContext
from log_commands.storage import entry_lock

RESERVED_TOKEN_RE = re.compile(r"<(project|log|theme)>")
CAPTURE_POLL_SECONDS = 0.05
CAPTURE_TERMINATION_SECONDS = 1.0


def usage() -> int:
    print(
        "usage: pyrun <script> [args...]\n"
        "       pyrun [--other-inputs <selectors>] "
        "[--other-outputs <selectors>]\n"
        "             [--capture-stdout <path>] "
        "[--capture-stderr <path>] -- <script> [args...]\n"
        "       pyrun --capture-stdout-stderr <path> -- <script> [args...]\n"
        "       pyrun data add <name> <file|directory> <location>\n"
        "       pyrun data add-identity-directory <name> <location> "
        "<identity-file>...\n"
        "       pyrun data add-identity-pattern-directory <name> <location> "
        "<identity-pattern>...\n"
        "       pyrun data update <name> <file|directory> <location>\n"
        "       pyrun data update-identity-directory <name> <location> "
        "<identity-file>...\n"
        "       pyrun data update-identity-pattern-directory <name> <location> "
        "<identity-pattern>...\n"
        "       pyrun data origin <name> <true|false>\n"
        "       pyrun data fingerprint <name>\n"
        "       pyrun data remove <name>",
        file=sys.stderr,
    )
    return 2


def project_root(cwd: Path) -> Path:
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as error:
        raise SystemExit("pyrun: could not resolve project root with git") from error
    return Path(output.strip()).resolve()


def python_executable(root: Path) -> str:
    project_conda = root / ".conda" / "bin" / "python"
    if project_conda.exists():
        return str(project_conda)
    return sys.executable


def is_log_root(candidate: Path) -> bool:
    return (candidate / "entries").is_dir() and (
        candidate.parent / f"{candidate.name}.md"
    ).is_file()


def log_root(cwd: Path) -> Path:
    for candidate in [cwd, *cwd.parents]:
        if is_log_root(candidate):
            return candidate.resolve()
    raise SystemExit(
        "pyrun: could not resolve log root; expected a <log>.md sibling and "
        "<log>/entries/"
    )


def find_entry_root(cwd: Path, log: Path) -> Path | None:
    entries = (log / "entries").resolve()
    for candidate in [cwd, *cwd.parents]:
        resolved = candidate.resolve()
        if resolved.parent == entries:
            return resolved
        if resolved == entries:
            break
    return None


def require_entry_root(cwd: Path, log: Path) -> Path:
    entry = find_entry_root(cwd, log)
    if entry is None or cwd.resolve() != entry:
        raise SystemExit("pyrun: data operations must run from an entry root")
    return entry


def _data_lock_path(path: Path) -> Path:
    identity = hashlib.sha256(str(path.resolve()).encode("utf-8")).hexdigest()
    return Path(tempfile.gettempdir()) / f"pyrun-data-{identity}.lock"


@contextmanager
def data_lock(path: Path) -> Iterator[None]:
    """Serialize updates without adding entry-local lock files."""

    with _data_lock_path(path).open("a+b") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def _load_data(entry: Path | None) -> DataFile | None:
    if entry is None:
        return None
    path = entry / "data.json"
    legacy = entry / "data.csv"
    unsupported = [
        candidate
        for root in (entry.parent, entry.parent.parent)
        for candidate in (root / "data.json", root / "data.csv")
        if candidate.exists()
    ]
    if unsupported:
        raise SystemExit(
            "pyrun: parent or log-level data files are unsupported: "
            + ", ".join(str(candidate) for candidate in unsupported)
        )
    if path.exists() and legacy.exists():
        raise SystemExit(f"pyrun: conflicting data.json and data.csv: {entry}")
    if legacy.exists():
        raise SystemExit(f"pyrun: legacy data.csv is unsupported: {legacy}")
    if not path.exists():
        return None
    try:
        return load_data_file(path, entry_root=entry)
    except DataContractError as error:
        raise SystemExit(f"pyrun: {error}") from error


def _serialized_data(data: DataFile) -> str:
    value = {
        "inputs": [
            item.as_dict() for item in sorted(data.inputs, key=lambda row: row.name)
        ],
        "schema": DATA_SCHEMA,
    }
    return json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n"


def _write_data(path: Path, entry: Path, inputs: tuple[InputResource, ...]) -> None:
    if not inputs:
        if path.exists():
            path.unlink()
            _sync_directory(path.parent)
        return
    try:
        data = data_file_from_inputs(path, entry_root=entry, inputs=inputs)
    except DataContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
    with tempfile.NamedTemporaryFile(
        "w", encoding="utf-8", dir=path.parent, delete=False
    ) as handle:
        handle.write(_serialized_data(data))
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    try:
        temporary.chmod(mode)
        os.replace(temporary, path)
        _sync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def _sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _update_data(
    entry: Path,
    operation: Callable[[DataFile | None], tuple[InputResource, ...]],
) -> None:
    path = entry / "data.json"
    try:
        with data_lock(path):
            current = _load_data(entry)
            _write_data(path, entry, operation(current))
    except OSError as error:
        raise SystemExit(
            f"pyrun: could not update data file: {path}: {error}"
        ) from error


def _items(data: DataFile | None) -> tuple[InputResource, ...]:
    return data.inputs if data is not None else ()


def _named(data: DataFile | None, name: str) -> InputResource:
    item = data.by_name.get(name) if data is not None else None
    if item is None:
        raise SystemExit(f"pyrun: unknown data input {name!r}")
    return item


def _replace_item(
    data: DataFile | None, name: str, replacement: InputResource | None
) -> tuple[InputResource, ...]:
    current = _named(data, name)
    return tuple(
        replacement if item is current and replacement is not None else item
        for item in _items(data)
        if item is not current or replacement is not None
    )


def add_local(
    entry: Path,
    name: str,
    kind: str,
    location: str,
    *,
    identity_files: tuple[str, ...] = (),
    identity_patterns: tuple[str, ...] = (),
) -> None:
    def operation(data: DataFile | None) -> tuple[InputResource, ...]:
        if data is not None and name in data.by_name:
            raise SystemExit(f"pyrun: duplicate data input {name!r}")
        try:
            if identity_files:
                item = build_identity_directory(
                    name,
                    location,
                    identity_files,
                    entry_root=entry,
                    origin=True,
                )
            elif identity_patterns:
                item = build_identity_pattern_directory(
                    name,
                    location,
                    identity_patterns,
                    entry_root=entry,
                    origin=True,
                )
            else:
                item = build_local_input(
                    name, kind, location, entry_root=entry, origin=True
                )
        except DataContractError as error:
            raise SystemExit(f"pyrun: {error}") from error
        return (*_items(data), item)

    _update_data(entry, operation)
    print(f"pyrun: added {name!r} to {entry / 'data.json'}")


def update_local(
    entry: Path,
    name: str,
    kind: str,
    location: str,
    *,
    identity_files: tuple[str, ...] = (),
    identity_patterns: tuple[str, ...] = (),
) -> None:
    def operation(data: DataFile | None) -> tuple[InputResource, ...]:
        current = _named(data, name)
        try:
            if identity_files:
                item = build_identity_directory(
                    name,
                    location,
                    identity_files,
                    entry_root=entry,
                    origin=current.origin,
                )
            elif identity_patterns:
                item = build_identity_pattern_directory(
                    name,
                    location,
                    identity_patterns,
                    entry_root=entry,
                    origin=current.origin,
                )
            else:
                item = build_local_input(
                    name,
                    kind,
                    location,
                    entry_root=entry,
                    origin=current.origin,
                )
        except DataContractError as error:
            raise SystemExit(f"pyrun: {error}") from error
        return _replace_item(data, name, item)

    _update_data(entry, operation)
    print(f"pyrun: updated {name!r} in {entry / 'data.json'}")


def set_origin(entry: Path, name: str, origin: bool) -> None:
    def operation(data: DataFile | None) -> tuple[InputResource, ...]:
        current = _named(data, name)
        return _replace_item(data, name, replace(current, origin=origin))

    _update_data(entry, operation)
    print(f"pyrun: set origin={str(origin).lower()} for {name!r}")


def refresh_fingerprint(entry: Path, name: str) -> None:
    def operation(data: DataFile | None) -> tuple[InputResource, ...]:
        current = _named(data, name)
        try:
            observed = observe_fingerprint(current)
        except DataContractError as error:
            raise SystemExit(f"pyrun: {error}") from error
        return _replace_item(
            data, name, replace(current, fingerprint=observed.fingerprint)
        )

    _update_data(entry, operation)
    print(f"pyrun: refreshed fingerprint for {name!r}")


def remove_input(entry: Path, name: str) -> None:
    _update_data(entry, lambda data: _replace_item(data, name, None))
    print(f"pyrun: removed {name!r} from {entry / 'data.json'}")


def _data_operation(argv: list[str], entry: Path) -> int:
    operation = argv[2] if len(argv) > 2 else ""
    if operation == "add" and len(argv) == 6:
        add_local(entry, argv[3], argv[4], argv[5])
        return 0
    if operation == "add-identity-directory" and len(argv) >= 6:
        add_local(
            entry,
            argv[3],
            "directory",
            argv[4],
            identity_files=tuple(argv[5:]),
        )
        return 0
    if operation == "add-identity-pattern-directory" and len(argv) >= 6:
        add_local(
            entry,
            argv[3],
            "directory",
            argv[4],
            identity_patterns=tuple(argv[5:]),
        )
        return 0
    if operation == "update" and len(argv) == 6:
        update_local(entry, argv[3], argv[4], argv[5])
        return 0
    if operation == "update-identity-directory" and len(argv) >= 6:
        update_local(
            entry,
            argv[3],
            "directory",
            argv[4],
            identity_files=tuple(argv[5:]),
        )
        return 0
    if operation == "update-identity-pattern-directory" and len(argv) >= 6:
        update_local(
            entry,
            argv[3],
            "directory",
            argv[4],
            identity_patterns=tuple(argv[5:]),
        )
        return 0
    if operation == "origin" and len(argv) == 5 and argv[4] in {"true", "false"}:
        set_origin(entry, argv[3], argv[4] == "true")
        return 0
    if operation == "fingerprint" and len(argv) == 4:
        refresh_fingerprint(entry, argv[3])
        return 0
    if operation == "remove" and len(argv) == 4:
        remove_input(entry, argv[3])
        return 0
    return usage()


def _reserved_tokens(arg: str, root: Path, log: Path) -> str:
    def replace_reserved(match: re.Match[str]) -> str:
        name = match.group(1)
        if name == "project":
            return str(root)
        if name == "log":
            return str(log)
        raise SystemExit("pyrun: <theme> is no longer supported; use <log>")

    return RESERVED_TOKEN_RE.sub(replace_reserved, arg)


def resolve_arg(
    arg: str,
    root: Path,
    log: Path,
    data: DataFile | None,
    verified: set[str],
    observed_inputs: dict[str, Fingerprint],
    fingerprint_cache: FingerprintCache,
) -> str:
    expanded = _reserved_tokens(arg, root, log)
    if not input_token_candidate(expanded):
        return expanded
    try:
        resolved = resolve_input_token(expanded, data)
    except DataContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    resource = resolved.resource
    if resource.name not in verified:
        try:
            observation = fingerprint_cache.verify(resource)
        except (DataContractError, FingerprintCacheError) as error:
            raise SystemExit(f"pyrun: {error}") from error
        if observation is None:
            raise SystemExit(f"pyrun: could not observe input {resource.name!r}")
        observed_inputs[resource.name] = observation.fingerprint
        verified.add(resource.name)
    return resolved.path


def _execution_layout(
    argv: list[str],
) -> tuple[
    str,
    tuple[str, ...],
    tuple[str, ...],
    dict[str, str],
    dict[str, str],
]:
    """Return the shared runner layout used to execute and publish support."""

    try:
        layout = parse_pyrun_arguments(argv[1:])
    except PyrunContractError as error:
        raise SystemExit(f"pyrun: {error}") from error
    return (
        layout.script,
        layout.script_arguments,
        layout.parameters,
        dict(layout.captures),
        dict(layout.roles),
    )


def _selected_values(
    arguments: tuple[str, ...], roles: dict[str, str], direction: str
) -> tuple[str, ...]:
    """Return every value selected for one explicit material direction."""

    options, positionals = split_argument_values(arguments)
    result: list[str] = []
    for occurrence in options:
        if roles.get(occurrence.name) == direction:
            result.append(occurrence.value)
    for index, value in enumerate(positionals, 1):
        if roles.get(f"@{index}") == direction:
            result.append(value)
    return tuple(result)


def _require_declared_input_tokens(
    arguments: tuple[str, ...], roles: dict[str, str], data: DataFile | None
) -> None:
    """Require explicit input roles to resolve through the owning registry."""

    for value in _selected_values(arguments, roles, "input"):
        expanded = value
        if not input_token_candidate(expanded):
            raise SystemExit(
                "pyrun: --other-inputs values must use registered input tokens"
            )
        try:
            resolve_input_token(expanded, data)
        except DataContractError as error:
            raise SystemExit(f"pyrun: {error}") from error


def _declared_outputs(
    arguments: tuple[str, ...],
    captures: dict[str, str],
    roles: dict[str, str],
    entry: Path,
    root: Path,
    log: Path,
) -> dict[str, tuple[Path, str | None]]:
    """Resolve outputs and any runner-enforced kind at the process boundary."""

    outputs: list[tuple[str, str | None]] = [
        (target, "file") for target in captures.values()
    ]
    options, positionals = split_argument_values(arguments)
    for option in options:
        role = roles.get(option.name, automatic_option_role(option.name))
        if role == "output":
            outputs.append((option.value, None))
    for index, value in enumerate(positionals, 1):
        if roles.get(f"@{index}") == "output":
            outputs.append((value, None))
    result: dict[str, tuple[Path, str | None]] = {}
    for raw, kind in outputs:
        expanded = _reserved_tokens(raw, root, log)
        path = Path(expanded) if Path(expanded).is_absolute() else entry / expanded
        key = portable_output_path(path, entry_root=entry)
        if key in result:
            raise SystemExit(f"pyrun: duplicate output target: {key}")
        result[key] = (path, kind)
    return result


def _capture_paths(
    captures: dict[str, str], entry: Path, root: Path, log: Path
) -> dict[str, Path]:
    result: dict[str, Path] = {}
    for option, raw in captures.items():
        expanded = _reserved_tokens(raw, root, log)
        path = Path(expanded) if Path(expanded).is_absolute() else entry / expanded
        portable_output_path(path, entry_root=entry)
        result[option] = path
    return result


def _run_with_captures(command: list[str], captures: dict[str, Path], cwd: Path) -> int:
    """Run one process while mirroring each requested captured byte stream."""

    if not captures:
        return subprocess.run(command, cwd=cwd, check=False).returncode
    capture_errors: list[BaseException] = []
    mirror_errors: list[BaseException] = []
    capture_failed = threading.Event()
    error_lock = threading.Lock()
    combined = captures.get("--capture-stdout-stderr")
    with ExitStack() as stack:
        handles = {
            option: stack.enter_context(path.open("wb"))
            for option, path in captures.items()
        }
        process = subprocess.Popen(
            command,
            cwd=cwd,
            stdout=subprocess.PIPE
            if combined is not None or "--capture-stdout" in captures
            else None,
            stderr=(
                subprocess.STDOUT
                if combined is not None
                else subprocess.PIPE
                if "--capture-stderr" in captures
                else None
            ),
        )
        pumps: list[threading.Thread] = []

        if process.stdout is not None:
            option = (
                "--capture-stdout-stderr"
                if combined is not None
                else "--capture-stdout"
            )
            thread = threading.Thread(
                target=_pump_captured_stream,
                args=(
                    process.stdout,
                    handles[option],
                    sys.stdout.buffer,
                    capture_failed,
                    capture_errors,
                    mirror_errors,
                    error_lock,
                ),
                daemon=True,
            )
            pumps.append(thread)
            thread.start()
        if process.stderr is not None:
            thread = threading.Thread(
                target=_pump_captured_stream,
                args=(
                    process.stderr,
                    handles["--capture-stderr"],
                    sys.stderr.buffer,
                    capture_failed,
                    capture_errors,
                    mirror_errors,
                    error_lock,
                ),
                daemon=True,
            )
            pumps.append(thread)
            thread.start()
        returncode = _wait_for_captured_process(process, capture_failed)
        for thread in pumps:
            thread.join()
        _flush_capture_handles(handles.values(), capture_errors, error_lock)
        if capture_errors:
            raise SystemExit(f"pyrun: capture failed: {capture_errors[0]}")
        if mirror_errors:
            raise SystemExit(f"pyrun: stream mirror failed: {mirror_errors[0]}")
        return returncode


def _pump_captured_stream(
    source: BinaryIO,
    destination: BinaryIO,
    mirror: BinaryIO,
    capture_failed: threading.Event,
    capture_errors: list[BaseException],
    mirror_errors: list[BaseException],
    error_lock: threading.Lock,
) -> None:
    """Capture one pipe completely, disabling only a failed destination."""

    capture_enabled = True
    mirror_enabled = True
    try:
        while chunk := source.read(1024 * 1024):
            if capture_enabled:
                try:
                    destination.write(chunk)
                    destination.flush()
                except BaseException as error:  # pragma: no cover - OS failure
                    _record_stream_error(capture_errors, error, error_lock)
                    capture_failed.set()
                    capture_enabled = False
            if mirror_enabled:
                try:
                    mirror.write(chunk)
                    mirror.flush()
                except BaseException as error:  # pragma: no cover - OS failure
                    _record_stream_error(mirror_errors, error, error_lock)
                    mirror_enabled = False
    except BaseException as error:  # pragma: no cover - OS pipe failure
        _record_stream_error(capture_errors, error, error_lock)
        capture_failed.set()


def _wait_for_captured_process(
    process: subprocess.Popen[bytes], capture_failed: threading.Event
) -> int:
    """Wait normally, but terminate a child whose capture destination failed."""

    while process.poll() is None:
        if not capture_failed.wait(CAPTURE_POLL_SECONDS):
            continue
        try:
            process.terminate()
        except OSError:
            pass
        try:
            return process.wait(timeout=CAPTURE_TERMINATION_SECONDS)
        except subprocess.TimeoutExpired:
            try:
                process.kill()
            except OSError:
                pass
            return process.wait()
    return process.wait()


def _flush_capture_handles(
    handles: Iterable[BinaryIO],
    errors: list[BaseException],
    error_lock: threading.Lock,
) -> None:
    for handle in handles:
        try:
            handle.flush()
            os.fsync(handle.fileno())
        except BaseException as error:  # pragma: no cover - OS failure
            _record_stream_error(errors, error, error_lock)


def _record_stream_error(
    errors: list[BaseException],
    error: BaseException,
    lock: threading.Lock,
) -> None:
    with lock:
        if not errors:
            errors.append(error)


def _observe_output(
    path: Path, expected_kind: str | None, fingerprint_cache: FingerprintCache
) -> Fingerprint:
    """Observe a captured file or the completed kind of an ordinary output."""

    kind = expected_kind or ("directory" if path.is_dir() else "file")
    try:
        observation = (
            fingerprint_cache.observe_directory(path)
            if kind == "directory"
            else fingerprint_cache.observe_regular_file(path)
        )
    except (DataContractError, FingerprintCacheError) as error:
        raise SystemExit(f"pyrun: could not observe output {path}: {error}") from error
    return observation.fingerprint


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return usage()

    cwd = Path.cwd()
    root = project_root(cwd)
    log = log_root(cwd)

    if argv[1] == "data":
        return _data_operation(argv, require_entry_root(cwd, log))

    entry = require_entry_root(cwd, log)
    entry_ids = [
        part for part in entry.name.split("-") if re.fullmatch(r"e[0-9]{3,}", part)
    ]
    if len(entry_ids) != 1:
        raise SystemExit("pyrun: could not resolve stable entry ID")
    operation_entry = EntryContext(
        LogContext(log.parent / f"{log.name}.md", log), entry_ids[0], entry
    )
    try:
        with (
            entry_lock(operation_entry),
            FingerprintCache(root, writable=True) as fingerprint_cache,
        ):
            quarantine_invalid_pyrun_outputs(entry)
            data = _load_data(entry)
            script_argument, script_args, parameters, captures, roles = (
                _execution_layout(argv)
            )
            _require_declared_input_tokens(script_args, roles, data)
            verified: set[str] = set()
            observed_inputs: dict[str, Fingerprint] = {}
            resolved_script = _reserved_tokens(script_argument, root, log)
            script_path = (
                Path(resolved_script)
                if Path(resolved_script).is_absolute()
                else entry / resolved_script
            )
            try:
                script_observation = fingerprint_cache.observe_regular_file(script_path)
            except FingerprintCacheError as error:
                raise SystemExit(f"pyrun: could not observe script: {error}") from error
            resolved_arguments = [
                resolve_arg(
                    arg,
                    root,
                    log,
                    data,
                    verified,
                    observed_inputs,
                    fingerprint_cache,
                )
                for arg in script_args
            ]
            output_paths = _declared_outputs(
                script_args, captures, roles, entry, root, log
            )
            capture_paths = _capture_paths(captures, entry, root, log)
            returncode = _run_with_captures(
                [python_executable(root), str(script_path), *resolved_arguments],
                capture_paths,
                cwd,
            )
            if returncode != 0:
                return returncode
            try:
                current_script = fingerprint_cache.observe_regular_file(script_path)
            except FingerprintCacheError as error:
                raise SystemExit(
                    f"pyrun: could not re-observe script: {error}"
                ) from error
            if current_script.fingerprint != script_observation.fingerprint:
                raise SystemExit("pyrun: script bytes changed during execution")
            if data is not None:
                for name, expected in sorted(observed_inputs.items()):
                    try:
                        current_input = fingerprint_cache.verify(data.by_name[name])
                    except (DataContractError, FingerprintCacheError) as error:
                        raise SystemExit(
                            f"pyrun: could not re-observe input {name!r}: {error}"
                        ) from error
                    if (
                        current_input is None
                        or current_input.fingerprint != expected
                    ):
                        raise SystemExit(
                            f"pyrun: input {name!r} changed during execution"
                        )
            script_support = ScriptSupport(
                script_argument, script_observation.fingerprint
            )
            records: dict[str, OutputSupport] = {}
            for key, (path, kind) in output_paths.items():
                if not path.exists():
                    continue
                records[key] = OutputSupport(
                    True,
                    _observe_output(path, kind, fingerprint_cache),
                    script_support,
                    parameters,
                    tuple(sorted(observed_inputs.items())),
                )
            if records:
                update_pyrun_outputs_locked(entry, records)
            return returncode
    except PyrunOutputsError as error:
        raise SystemExit(f"pyrun: {error}") from error
    except OSError as error:
        raise SystemExit(f"pyrun: operation state unavailable: {error}") from error


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
