#!/usr/bin/env python3
"""Run entry-local Python commands and add data-index rows."""

from __future__ import annotations

import csv
import fcntl
import hashlib
import os
import re
import stat
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from pathlib import Path
from typing import Iterator

from research_log_data_index import (
    DATA_INDEX_FIELDS,
    TOKEN_RE,
    DataIndex,
    DataIndexError,
    read_data_index as _read_data_index,
    validate_data_name as _validate_data_name,
)


URI_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
WINDOWS_DRIVE_RE = re.compile(r"^[A-Za-z]:[\\/]")


def usage() -> int:
    print(
        "usage: pyrun <script> [args...]\n"
        "       pyrun data add <name> <type> <location>",
        file=sys.stderr,
    )
    return 2


def project_root(cwd: Path) -> Path:
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit("pyrun: could not resolve project root with git") from exc
    return Path(output.strip())


def python_executable(root: Path) -> str:
    project_conda = root / ".conda" / "bin" / "python"
    if project_conda.exists():
        return str(project_conda)
    return sys.executable


def is_log_root(candidate: Path) -> bool:
    return (candidate / "entries").is_dir() and (
        candidate.parent / f"{candidate.name}.md"
    ).is_file()


def log_root(cwd: Path) -> Path:
    for candidate in [cwd, *cwd.parents]:
        if is_log_root(candidate):
            return candidate

    parts = cwd.parts
    for index, part in enumerate(parts):
        if part != "entries" or index == 0:
            continue
        candidate = Path(*parts[:index])
        if is_log_root(candidate):
            return candidate

    raise SystemExit(
        "pyrun: could not resolve log root; expected a <log>.md sibling and <log>/entries/"
    )


def data_index_candidates(cwd: Path) -> list[Path]:
    return [
        cwd / "data.csv",
        cwd.parent / "data.csv",
    ]


def find_data_index(cwd: Path) -> Path | None:
    for candidate in data_index_candidates(cwd):
        if candidate.is_file():
            return candidate
    return None


def validate_data_name(name: str, index: Path) -> None:
    try:
        _validate_data_name(name)
    except DataIndexError as exc:
        raise SystemExit(f"pyrun: {exc}: {index}") from exc


def read_data_index(index: Path) -> DataIndex:
    try:
        return _read_data_index(index)
    except DataIndexError as exc:
        raise SystemExit(f"pyrun: {exc}: {index}") from exc


def data_locations(index: Path | None) -> dict[str, str]:
    if index is None:
        return {}
    return read_data_index(index).locations


def entry_root(cwd: Path, log: Path) -> Path:
    if cwd.parent != log / "entries":
        raise SystemExit("pyrun: data add must run from an entry root")
    return cwd


def _data_index_lock_path(index: Path) -> Path:
    identity = hashlib.sha256(str(index.resolve()).encode("utf-8")).hexdigest()
    return Path(tempfile.gettempdir()) / f"pyrun-data-{identity}.lock"


@contextmanager
def data_index_lock(index: Path) -> Iterator[None]:
    """Serialize updates to one data index without adding entry-local files."""

    with _data_index_lock_path(index).open("a+b") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def _write_data_index(index: Path, data: DataIndex) -> None:
    index.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(index.stat().st_mode) if index.exists() else 0o644
    with tempfile.NamedTemporaryFile(
        "w",
        newline="",
        encoding="utf-8",
        dir=index.parent,
        delete=False,
    ) as handle:
        writer = csv.DictWriter(
            handle,
            fieldnames=DATA_INDEX_FIELDS,
            lineterminator="\n",
        )
        writer.writeheader()
        writer.writerows(data.rows)
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    try:
        temporary.chmod(mode)
        os.replace(temporary, index)
        directory = os.open(index.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def add_data(index: Path, name: str, data_type: str, location: str) -> None:
    values = [value.strip() for value in (name, data_type, location)]
    if any(not value for value in values):
        raise SystemExit("pyrun: data add requires nonempty name, type, and location")
    name, data_type, location = values
    validate_data_name(name, index)

    try:
        with data_index_lock(index):
            if index.exists():
                data = read_data_index(index)
                if name in data.locations:
                    raise SystemExit(f"pyrun: duplicate data name {name!r}: {index}")
            else:
                data = DataIndex(rows=[], locations={})

            row = {"name": name, "type": data_type, "location": location}
            updated = DataIndex(
                rows=[*data.rows, row],
                locations={**data.locations, name: location},
            )
            _write_data_index(index, updated)
    except OSError as exc:
        raise SystemExit(f"pyrun: could not update data index: {index}: {exc}") from exc

    print(f"pyrun: added {name!r} to {index}")


def resolve_location(location: str, index: Path) -> str:
    if URI_RE.match(location) and not WINDOWS_DRIVE_RE.match(location):
        return location
    path = Path(location).expanduser()
    if path.is_absolute():
        return str(path)
    return str((index.parent / path).resolve())


def resolve_arg(
    arg: str,
    root: Path,
    log: Path,
    locations: dict[str, str],
    index: Path | None,
) -> str:
    def replace(match: re.Match[str]) -> str:
        name = match.group(1)
        if name == "project":
            return str(root)
        if name == "log":
            return str(log)
        if name == "theme":
            raise SystemExit("pyrun: <theme> is no longer supported; use <log>")
        if name in locations:
            if index is None:
                raise SystemExit(
                    "pyrun: internal error resolving data name without "
                    f"data index: {name}"
                )
            return resolve_location(locations[name], index)
        raise SystemExit(f"pyrun: unresolved token <{name}> in argument: {arg}")

    return TOKEN_RE.sub(replace, arg)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return usage()

    cwd = Path.cwd()
    root = project_root(cwd)
    log = log_root(cwd)

    if argv[1] == "data":
        if len(argv) != 6 or argv[2] != "add":
            return usage()
        add_data(entry_root(cwd, log) / "data.csv", *argv[3:])
        return 0

    index = find_data_index(cwd)
    locations = data_locations(index)
    resolved = [resolve_arg(arg, root, log, locations, index) for arg in argv[1:]]

    return subprocess.run([python_executable(root), *resolved], cwd=cwd).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
