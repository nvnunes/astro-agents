#!/usr/bin/env python3
"""Run entry-local Python commands and add data-index rows."""

from __future__ import annotations

import csv
import re
import subprocess
import sys
from pathlib import Path


TOKEN_RE = re.compile(r"<([^<>]+)>")
URI_RE = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
WINDOWS_DRIVE_RE = re.compile(r"^[A-Za-z]:[\\/]")
DATA_INDEX_FIELDS = ("name", "type", "location")
RESERVED_DATA_NAMES = {"log", "project", "theme"}


def usage() -> int:
    print(
        "usage: pyrun <script> [args...]\n"
        "       pyrun data add <name> <type> <location>",
        file=sys.stderr,
    )
    return 2


def project_root(cwd: Path) -> Path:
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError) as exc:
        raise SystemExit("pyrun: could not resolve project root with git") from exc
    return Path(output.strip())


def python_executable(root: Path) -> str:
    project_conda = root / ".conda" / "bin" / "python"
    if project_conda.exists():
        return str(project_conda)
    return sys.executable


def is_log_root(candidate: Path) -> bool:
    return (candidate / "entries").is_dir() and (candidate.parent / f"{candidate.name}.md").is_file()


def log_root(cwd: Path) -> Path:
    for candidate in [cwd, *cwd.parents]:
        if is_log_root(candidate):
            return candidate

    parts = cwd.parts
    for index, part in enumerate(parts):
        if part != "entries" or index == 0:
            continue
        candidate = Path(*parts[:index])
        if is_log_root(candidate):
            return candidate

    raise SystemExit(
        "pyrun: could not resolve log root; expected a <log>.md sibling and <log>/entries/"
    )


def data_index_candidates(cwd: Path) -> list[Path]:
    return [
        cwd / "data.csv",
        cwd.parent / "data.csv",
    ]


def find_data_index(cwd: Path) -> Path | None:
    for candidate in data_index_candidates(cwd):
        if candidate.is_file():
            return candidate
    return None


def validate_data_name(name: str, index: Path) -> None:
    if name in RESERVED_DATA_NAMES:
        raise SystemExit(f"pyrun: reserved data name {name!r}: {index}")


def read_data_index(index: Path) -> tuple[list[str], dict[str, str], dict[str, str]]:
    try:
        with index.open(newline="", encoding="utf-8") as handle:
            reader = csv.DictReader(handle)
            if reader.fieldnames is None:
                raise SystemExit(f"pyrun: empty data index: {index}")

            columns = list(reader.fieldnames)
            fields_by_name = {name.strip().lower(): name for name in columns if name}
            missing = set(DATA_INDEX_FIELDS) - set(fields_by_name)
            if missing:
                missing_text = ", ".join(sorted(missing))
                raise SystemExit(f"pyrun: data index missing required column(s) {missing_text}: {index}")

            locations: dict[str, str] = {}
            for line_number, row in enumerate(reader, start=2):
                name = (row.get(fields_by_name["name"]) or "").strip()
                data_type = (row.get(fields_by_name["type"]) or "").strip()
                location = (row.get(fields_by_name["location"]) or "").strip()
                if not name and not data_type and not location:
                    continue
                if not name or not data_type or not location:
                    raise SystemExit(f"pyrun: malformed data index row {line_number}: {index}")
                validate_data_name(name, index)
                if name in locations:
                    raise SystemExit(
                        f"pyrun: duplicate data name {name!r} on line {line_number}: {index}"
                    )
                locations[name] = location
    except csv.Error as exc:
        raise SystemExit(f"pyrun: malformed CSV data index: {index}: {exc}") from exc

    return columns, fields_by_name, locations


def data_locations(index: Path | None) -> dict[str, str]:
    if index is None:
        return {}
    return read_data_index(index)[2]


def entry_root(cwd: Path, log: Path) -> Path:
    if cwd.parent != log / "entries":
        raise SystemExit("pyrun: data add must run from an entry root")
    return cwd


def add_data(index: Path, name: str, data_type: str, location: str) -> None:
    values = [value.strip() for value in (name, data_type, location)]
    if any(not value for value in values):
        raise SystemExit("pyrun: data add requires nonempty name, type, and location")
    name, data_type, location = values
    validate_data_name(name, index)

    if index.exists():
        columns, fields_by_name, locations = read_data_index(index)
        if name in locations:
            raise SystemExit(f"pyrun: duplicate data name {name!r}: {index}")
        needs_newline = not index.read_bytes().endswith((b"\n", b"\r"))
        mode = "a"
    else:
        columns = list(DATA_INDEX_FIELDS)
        fields_by_name = {field: field for field in DATA_INDEX_FIELDS}
        needs_newline = False
        mode = "w"

    row = {field: "" for field in columns}
    row[fields_by_name["name"]] = name
    row[fields_by_name["type"]] = data_type
    row[fields_by_name["location"]] = location

    with index.open(mode, newline="", encoding="utf-8") as handle:
        if needs_newline:
            handle.write("\n")
        writer = csv.DictWriter(handle, fieldnames=columns, lineterminator="\n")
        if mode == "w":
            writer.writeheader()
        writer.writerow(row)

    print(f"pyrun: added {name!r} to {index}")


def resolve_location(location: str, index: Path) -> str:
    if URI_RE.match(location) and not WINDOWS_DRIVE_RE.match(location):
        return location
    path = Path(location).expanduser()
    if path.is_absolute():
        return str(path)
    return str((index.parent / path).resolve())


def resolve_arg(arg: str, root: Path, log: Path, locations: dict[str, str], index: Path | None) -> str:
    def replace(match: re.Match[str]) -> str:
        name = match.group(1)
        if name == "project":
            return str(root)
        if name == "log":
            return str(log)
        if name == "theme":
            raise SystemExit("pyrun: <theme> is no longer supported; use <log>")
        if name in locations:
            if index is None:
                raise SystemExit(f"pyrun: internal error resolving data name without data index: {name}")
            return resolve_location(locations[name], index)
        raise SystemExit(f"pyrun: unresolved token <{name}> in argument: {arg}")

    return TOKEN_RE.sub(replace, arg)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return usage()

    cwd = Path.cwd()
    root = project_root(cwd)
    log = log_root(cwd)

    if argv[1] == "data":
        if len(argv) != 6 or argv[2] != "add":
            return usage()
        add_data(entry_root(cwd, log) / "data.csv", *argv[3:])
        return 0

    index = find_data_index(cwd)
    locations = data_locations(index)
    resolved = [resolve_arg(arg, root, log, locations, index) for arg in argv[1:]]

    return subprocess.run([python_executable(root), *resolved], cwd=cwd).returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
